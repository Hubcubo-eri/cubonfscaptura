# Application
APP_NAME=CUBO Captura
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./cubo_captura.db
# DATABASE_URL=postgresql+psycopg2://cubo:cubopwd@db:5432/cubo_captura

# Storage
STORAGE_PATH=./storage
CERT_STORAGE_PATH=./storage/certificados
XML_STORAGE_PATH=./storage/xmls

# Security — gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MASTER_KEY=change-me-to-a-strong-random-key-32bytes-minimum
JWT_SECRET=change-me-too-use-another-strong-random-value
JWT_ACCESS_TOKEN_HOURS=12

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (for Celery)
REDIS_URL=redis://redis:6379/0

# GISS
GISS_WSDL_MACEIO=https://ws-maceio.giss.com.br/service-ws/nf/nfse-ws?wsdl
GISS_TIMEOUT_SECONDS=60

# Admin inicial (criado uma vez no primeiro startup)
# Deixe vazio para não criar; mude a senha depois via API.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador
